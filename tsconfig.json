{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "lib":["ES2019","dom"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "verbatimModuleSyntax": true
  },

  "references": [
    {
      "path": "./tsconfig.config.json"
    }
  ]
}
